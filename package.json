{
	"name": "tableau-to-domo",
	"version": "0.1.0",
	"description": "Migrate Tableau workbooks (data, calculations, worksheets, dashboards) to Domo",
	"license": "MIT",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"bin": {
		"t2d": "./bin/t2d.js"
	},
	"main": "./src/index.js",
	"exports": {
		".": "./src/index.js",
		"./package.json": "./package.json"
	},
	"files": [
		"bin/",
		"src/",
		"python/",
		".env.example",
		"README.md"
	],
	"scripts": {
		"test": "node --test \"test/**/*.test.js\"",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix"
	},
	"dependencies": {
		"csv-parse": "^7.0.3",
		"dotenv": "^18.0.7",
		"fast-xml-parser": "^5.11.2",
		"yauzl": "^3.4.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.12.0",
		"globals": "^17.13.0"
	}
}
