# Tableau (Server or Cloud). TABLEAU_SITE is the site contentUrl; leave blank for the Default site.
TABLEAU_SERVER=https://prod-useast-a.online.tableau.com
TABLEAU_SITE=
TABLEAU_PAT_NAME=
TABLEAU_PAT_SECRET=
# Optional: pin a REST API version instead of detecting it from serverinfo.
TABLEAU_API_VERSION=

# Domo
DOMO_INSTANCE=
DOMO_ACCESS_TOKEN=

# Snowflake, for --snowflake-views (optional). A service user whose role can CREATE VIEW in SNOWFLAKE_VIEW_SCHEMA
# and SELECT the source tables. Set SNOWFLAKE_PAT (a programmatic access token) or SNOWFLAKE_PRIVATE_KEY_PATH.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_VIEW_SCHEMA=
SNOWFLAKE_PAT=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# Optional
# T2D_WORKSPACE=./t2d-work
# T2D_PYTHON=python3
