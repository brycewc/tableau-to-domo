					{
						"id": "[Calculation_1881660259991142401]",
						"name": "RelativeStartDateFilter",
						"datatype": "boolean",
						"role": "dimension",
						"type": "nominal",
						"kind": "calculated",
						"caption": "RelativeStartDateFilter",
						"defaultAggregation": "Count",
						"formula": "if [Parameters].[Parameter 1]='All' then TRUE\nELSEIF  [Parameters].[Parameter 1]='Today' then [DAYS_SINCE_START]=0\nELSEIF [Parameters].[Parameter 1]='Yesterday' then [DAYS_SINCE_START]=1\nELSEIF [Parameters].[Parameter 1]='Current Week' then [LASTRENEWALDATE]>=DATETRUNC('week',TODAY()) and [LASTRENEWALDATE]<=TODAY()\nELSEIF [Parameters].[Parameter 1]='Last Week' then [LASTRENEWALDATE]>= DATEADD('day',-7,DATETRUNC('week',TODAY())) and [LASTRENEWALDATE]<DATETRUNC('week',TODAY())\nELSEIF([Parameters].[Parameter 1]='Current FP' and [FISCAL_PERIOD_NUM]=[CURRENTFP] and [FISCAL_YEAR_NUM]=[CURRENTFY]) then true\nELSEIF( [Parameters].[Parameter 1]='Last FP' and ( IF [CURRENTFP]=1 then ([FISCAL_PERIOD_NUM]=12 and [FISCAL_YEAR_NUM]=[CURRENTFY]-1) else [FISCAL_PERIOD_NUM]=[CURRENTFP]-1 END )) then true\nELSEIF([Parameters].[Parameter 1]='Current FQ' and [FISCAL_QUARTER_NUM]=[CURRENTFQ] and [FISCAL_YEAR_NUM]=[CURRENTFY]) then true\nELSEIF( [Parameters].[Parameter 1]='Last FQ' and ( IF [CURRENTFQ]=1 then ([FISCAL_QUARTER_NUM]=4 and [FISCAL_YEAR_NUM]=[CURRENTFY]-1) else [FISCAL_QUARTER_NUM]=[CURRENTFQ]-1 END )) then true\nEND"
					},
