					{
						"id": "[Calculation_306807742254063616]",
						"name": "IsAgent",
						"datatype": "boolean",
						"role": "dimension",
						"type": "nominal",
						"kind": "calculated",
						"caption": "IsAgent",
						"defaultAggregation": "Count",
						"formula": "if CONTAINS(UPPER([ASSIGNED_TO]),'AGENT A')   OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT B')     OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT C')      OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT D')       OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT E')        OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT F')    OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT G')       OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT H')     OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT I')       OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT J')       OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT K')       OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT L')       OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT M')      OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT N')    OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT O')      OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT P')       OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT Q')       OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT R')     OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT S')    OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT T')    OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT U')   OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT V')    OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT W')      OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT X')       OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT Y')       OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT Z')      OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT AA')        OR\n\t\tCONTAINS(UPPER([ASSIGNED_TO]),'AGENT AB')  \nthen TRUE\nEND"
					},
					{
						"id": "[Calculation_653303454325510147]",
						"name": "Usage Bucket",
						"datatype": "string",
						"role": "dimension",
						"type": "nominal",
						"kind": "calculated",
						"caption": "Usage Bucket",
						"defaultAggregation": "Count",
						"formula": "if [Calculation_1284651817373192194]<=0  or ISNULL([Calculation_1284651817373192194]) then '0%'\nELSEIF  [Calculation_1284651817373192194]>0 and [Calculation_1284651817373192194]<0.2 then '(0.1-19)%' \nELSEIF  [Calculation_1284651817373192194]>=0.2 and [Calculation_1284651817373192194]<0.4 then '(20-39)%' \nELSEIF  [Calculation_1284651817373192194]>=0.4 and [Calculation_1284651817373192194]<0.6 then '(40-59)%' \nELSEIF  [Calculation_1284651817373192194]>=0.6 and [Calculation_1284651817373192194]<0.8 then '(60-79)%' \nELSEIF  [Calculation_1284651817373192194]>=0.8 and [Calculation_1284651817373192194]<=1  then '(80-100)%'\nELSEIF [Calculation_1284651817373192194]>1 then '>100%'\nEND"
