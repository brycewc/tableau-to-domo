						"id": "[Calculation_1881660261100523530]",
						"name": "SortingField",
						"datatype": "real",
						"role": "dimension",
						"type": "ordinal",
						"kind": "calculated",
						"defaultAggregation": "Count",
						"caption": "SortingField",
						"formula": "if [Parameters].[Parameter 2]='TotalLicenses' then [TotalLicenses (copy)_1387671648276766720]*[Calculation_1881660261106843659]\nELSEIF [Parameters].[Parameter 2]='Usage%' then [Usage% (copy)_1387671648284012545]*[Calculation_1881660261106843659]\nELSEIF [Parameters].[Parameter 2]='Days Since Start' then [Calculation_799107516721373185]*[Calculation_1881660261106843659]\nELSEIF [Parameters].[Parameter 2]='Days Until Renewal' then [DAYS_UNTIL_RENEWAL]*[Calculation_1881660261106843659]\nELSEIF [Parameters].[Parameter 2]='ARR' then [ARR]*[Calculation_1881660261106843659]\nELSEIF [Parameters].[Parameter 2]='LastActivityDate' then DATEDIFF('day',date([AgentActivityCount (copy)_1804536092293087233]), DATE(TODAY()))*[Calculation_1881660261106843659]*-1\nEND"
					},
					{
						"id": "[Calculation_1930636917600223232]",
						"name": "AgentOutreach",
						"datatype": "boolean",
						"role": "dimension",
						"type": "nominal",
						"kind": "calculated",
						"caption": "AgentOutreach",
